// Prisma schema for P-Core Management System
// This schema defines all database models for the multi-tenant educational management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String   @unique
  image             String?
  password          String?  // Added for password-based authentication
  role              UserRole @default(USER)
  isTwoFactorEnabled Boolean @default(false)
  emailVerified     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  defaultOrgId      String?

  // Relations
  organizations     UserOrganization[]
  ownedOrganizations Organization[]
  notifications     Notification[]
  activities        Activity[]
  subscriptions     Subscription[]
  profile           UserProfile?
  accounts          Account[]
  sessions          Session[]
  ledTeams          Team[]
  twoFactorConfirmation TwoFactorConfirmation?

  @@map("users")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  location    String?
  website     String?
  socialLinks String? // JSON string: { twitter?: string, linkedin?: string, github?: string }
  preferences String   @default("{}") // JSON string: UserPreferences

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("two_factor_tokens")
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_confirmations")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

// ============================================================================
// ORGANIZATION MANAGEMENT
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  website     String?
  type        OrgType  @default(COMPANY)
  size        OrgSize  @default(SMALL)
  industry    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String
  settings    String   @default("{}") // JSON string: OrganizationSettings

  // Relations
  owner        User              @relation(fields: [ownerId], references: [id])
  members      UserOrganization[]
  teams        Team[]
  activities   Activity[]

  @@map("organizations")
}

model UserOrganization {
  id             String            @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole  @default(MEMBER)
  status         MemberStatus      @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

model Team {
  id             String   @id @default(cuid())
  name           String
  description    String?
  leaderId       String
  organizationId String
  memberIds      String   @default("[]") // JSON string array of user IDs
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  settings       String   @default("{}") // JSON string: TeamSettings

  // Relations
  leader       User         @relation(fields: [leaderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("teams")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id          String            @id @default(cuid())
  title       String
  message     String
  type        NotificationType  @default(INFO)
  recipients  String            @default("[]") // JSON string array of user IDs or special values like 'all', 'admins'
  senderId    String
  isRead      Boolean           @default(false)
  readAt      DateTime?
  actionUrl   String?
  metadata    String?           // JSON string: Additional data
  createdAt   DateTime          @default(now())
  expiresAt   DateTime?

  // Relations
  sender User @relation(fields: [senderId], references: [id])

  @@map("notifications")
}

model NotificationTemplate {
  id        String            @id @default(cuid())
  name      String            @unique
  title     String
  message   String
  type      NotificationType  @default(INFO)
  variables String            @default("[]") // JSON string array of variable names
  category  TemplateCategory
  isActive  Boolean           @default(true)

  @@map("notification_templates")
}

// ============================================================================
// ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("[]") // JSON string array of permission IDs
  isSystem    Boolean  @default(false)
  userCount   Int      @default(0)
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  category    PermissionCategory
  resource    String
  action      String
  isSystem    Boolean            @default(false)

  @@unique([resource, action])
  @@map("permissions")
}

// ============================================================================
// PLANS & BILLING
// ============================================================================

model Plan {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  price       Float
  interval    PlanInterval
  currency    String        @default("USD")
  features    String        @default("[]") // JSON string array of feature strings
  limits      String        @default("{}") // JSON string: PlanLimits
  isActive    Boolean       @default(true)
  isPopular   Boolean       @default(false)
  sortOrder   Int           @default(0)
  trialDays   Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String           @id @default(cuid())
  userId              String
  planId              String
  status              SubscriptionStatus @default(TRIALING)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean          @default(false)
  trialEnd            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Invoice {
  id             String          @id @default(cuid())
  subscriptionId String
  amount         Float
  currency       String          @default("USD")
  status         InvoiceStatus   @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("invoices")
}

// ============================================================================
// ANALYTICS & ACTIVITY
// ============================================================================

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  description    String
  userId         String?
  organizationId String?
  metadata       String?      // JSON string: Additional data
  timestamp      DateTime     @default(now())

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("activities")
}

// ============================================================================
// SCHOOL MANAGEMENT
// ============================================================================

model Student {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String?  @unique
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  enrollmentDate DateTime @default(now())
  status         String   @default("active") // active, inactive, graduated, transferred
  grade          String?
  studentId      String?  @unique
  emergencyContact String? // JSON string: { name: string, phone: string, relationship: string }
  medicalInfo    String? // JSON string: { allergies: string[], medications: string[], conditions: string[] }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  enrollments Enrollment[]

  @@map("students")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  credits     Int      @default(1)
  subject     String
  gradeLevel  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enrollments Enrollment[]
  schedules   Schedule[]

  @@map("courses")
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  grade      String?
  status     String   @default("enrolled") // enrolled, completed, dropped, failed
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Schedule {
  id         String   @id @default(cuid())
  courseId   String
  dayOfWeek  Int      // 0-6 (Sunday-Saturday)
  startTime  String   // HH:MM format
  endTime    String   // HH:MM format
  room       String?
  instructor String?
  semester   String?
  year       Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

// ============================================================================
// CHURCH MANAGEMENT
// ============================================================================

model ChurchMember {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  joinDate    DateTime @default(now())
  status      String   @default("active") // active, inactive, transferred
  memberId    String?  @unique
  baptismDate DateTime?
  maritalStatus String?
  occupation  String?
  emergencyContact String? // JSON string: { name: string, phone: string, relationship: string }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  familyMembers FamilyMember[]
  choirMembers  ChoirMember[]

  @@map("church_members")
}

model Family {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  headId    String   // Reference to ChurchMember
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id         String   @id @default(cuid())
  familyId   String
  memberId   String
  relationship String // father, mother, son, daughter, etc.
  isHead     Boolean  @default(false)

  // Relations
  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member ChurchMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([familyId, memberId])
  @@map("family_members")
}

model Choir {
  id          String   @id @default(cuid())
  name        String
  description String?
  director    String?
  type        String   @default("mixed") // mixed, men, women, children
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members ChoirMember[]

  @@map("choirs")
}

model ChoirMember {
  id       String   @id @default(cuid())
  choirId  String
  memberId String
  role     String   @default("member") // member, director, accompanist
  joinedAt DateTime @default(now())

  // Relations
  choir  Choir        @relation(fields: [choirId], references: [id], onDelete: Cascade)
  member ChurchMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([choirId, memberId])
  @@map("choir_members")
}

model ChurchEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  location    String?
  type        String   @default("service") // service, meeting, concert, etc.
  organizer   String?
  maxAttendees Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("church_events")
}

// ============================================================================
// LIBRARY MANAGEMENT
// ============================================================================

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String?  @unique
  publisher   String?
  publishYear Int?
  genre       String?
  description String?
  language    String   @default("English")
  pages       Int?
  coverImage  String?
  quantity    Int      @default(1)
  available   Int      @default(1)
  location    String?  // shelf location
  condition   String   @default("good") // excellent, good, fair, poor
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  loans        Loan[]
  reservations Reservation[]

  @@map("books")
}

model Loan {
  id         String   @id @default(cuid())
  bookId     String
  userId     String   // Could be student ID or general user ID
  userType   String   @default("student") // student, staff, member
  loanDate   DateTime @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String   @default("active") // active, returned, overdue
  fine       Float    @default(0)
  notes      String?

  // Relations
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("loans")
}

model Reservation {
  id         String   @id @default(cuid())
  bookId     String
  userId     String
  userType   String   @default("student")
  reserveDate DateTime @default(now())
  expiryDate DateTime // When reservation expires
  status     String   @default("active") // active, fulfilled, expired, cancelled
  notes      String?

  // Relations
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
  DEVELOPMENT
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OrgType {
  COMPANY
  STARTUP
  NONPROFIT
  EDUCATION
  PERSONAL
}

enum OrgSize {
  SMALL     // 1-10
  MEDIUM    // 11-50
  LARGE     // 51-200
  ENTERPRISE // 201-1000
  ENTERPRISE_PLUS // 1000+
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum TemplateCategory {
  SYSTEM
  USER
  MARKETING
  SECURITY
}

enum PermissionCategory {
  USERS
  ORGANIZATIONS
  TEAMS
  PROJECTS
  CONTENT
  ANALYTICS
  SETTINGS
  BILLING
  NOTIFICATIONS
  API
  SYSTEM
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum ActivityType {
  USER_REGISTERED
  ORGANIZATION_CREATED
  USER_LOGIN
  SYSTEM_UPDATE
  NOTIFICATION_SENT
}
